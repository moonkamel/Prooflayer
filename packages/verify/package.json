      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "asn1js": "4.0.0",
    "fflate": "0.8.3",
    "pkijs": "4.0.1"
  }
}
