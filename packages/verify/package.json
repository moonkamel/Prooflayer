{
  "name": "@prooflayer/verify",
  "version": "0.1.0",
  "description": "Vérifie hors ligne un pack d'audit ProofLayer : signature, preuves, lots de Merkle, ancres, jetons RFC 3161.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "prooflayer-verify": "dist/bin.js"
  },
