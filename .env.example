# Copier en .env (jamais versionné). Les valeurs ci-dessous sont factices et visent un Postgres local.
#
# Supabase (projet « prooflayer », région eu-central-1 Francfort) — à reprendre depuis
# Project Settings → Database → Connection string, en remplaçant <ref>, <mot-de-passe> et <region> :
#
#   Exécution, rôle applicatif, pooler en mode transaction (port 6543) :
#   DATABASE_URL="postgresql://prooflayer_app.<ref>:<mot-de-passe>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"
#
#   Migrations, rôle de migration, connexion directe (port 5432) :
#   DIRECT_DATABASE_URL="postgresql://postgres:<mot-de-passe>@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Exécution : rôle applicatif prooflayer_app (sans BYPASSRLS).
DATABASE_URL="postgresql://prooflayer_app:prooflayer_app@localhost:5432/prooflayer"

# Migrations et données de démonstration : rôle de migration, propriétaire des tables.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prooflayer"

# Authentification (PL-103). Secret : 32 octets aléatoires au moins, par exemple `openssl rand -base64 32`.
# Il chiffre aussi les secrets TOTP en base : le changer invalide la double authentification existante.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Connexion Google (OIDC), facultative : le bouton n'apparaît que si les deux valeurs sont définies.
# Console Google Cloud → API et services → Identifiants → ID client OAuth (application Web),
# URI de redirection autorisée : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails. Avant PL-108, seul le transport « outbox » existe : les emails sont écrits dans EMAIL_OUTBOX_DIR/outbox.jsonl.
EMAIL_TRANSPORT="outbox"
EMAIL_OUTBOX_DIR=".outbox"

# Routes /api/cron/* (PL-107) : Vercel Cron envoie « Authorization: Bearer $CRON_SECRET ».
# 32 caractères au moins, par exemple `openssl rand -hex 32` ; sans lui, les routes cron refusent tout appel.
CRON_SECRET=""
